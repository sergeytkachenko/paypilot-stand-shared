# --- Stand behaviour ---
# Profile of the active lesson: clean | lesson-01 .. lesson-14
PROFILE=clean
# Extra defects outside the profile, comma-separated ids: DEFECTS=<id>,<id>
DEFECTS=
# Fixed "current" date for the whole run (ISO). Keeps dispute-window cases stable.
CLOCK_OVERRIDE=2026-09-15T10:00:00Z

# --- LLM provider ---
# mock (no key, deterministic) | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=
EXPLAIN_MODEL=
ROUTER=
ROUTER_PROFILES=clean
ROUTER_MIN_CONFIDENCE=0.9
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent ---
MAX_AGENT_STEPS=12
SUMMARIZE_AFTER_STEPS=8

# --- RAG ---
# kb_clean | kb_broken (normally driven by profile; env is an explicit override)
KB_INDEX=
RAG_TOP_K=4

# --- Shared stand ---
STAND_LOCK_GLOBAL=0
STAND_ADMIN_TOKEN=
# Student keys: spending routes need X-Stand-Key; issue keys with scripts/keys.py
STAND_KEYS_REQUIRED=0
STAND_KEY_DAILY_USD=1.0
STAND_KEY_MONTHLY_USD=5.0
